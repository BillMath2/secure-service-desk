{
  "additionalProperties": false,
  "properties": {
    "scenario_id": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "failure",
        "error",
        "unsupported"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "actor": {
      "title": "Actor",
      "type": "string"
    },
    "entry_point": {
      "title": "Entry Point",
      "type": "string"
    },
    "requirements": {
      "items": {
        "type": "string"
      },
      "title": "Requirements",
      "type": "array"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "audit_event_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Audit Event Ids",
      "type": "array"
    },
    "output_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Sha256"
    },
    "forbidden_marker_found": {
      "default": false,
      "title": "Forbidden Marker Found",
      "type": "boolean"
    },
    "mutations_found": {
      "default": false,
      "title": "Mutations Found",
      "type": "boolean"
    }
  },
  "required": [
    "scenario_id",
    "status",
    "reason",
    "actor",
    "entry_point",
    "requirements",
    "risks"
  ],
  "title": "ScenarioResult",
  "type": "object"
}
