{
  "$defs": {
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "title": "Allow",
          "type": "boolean"
        },
        "reason_code": {
          "$ref": "#/$defs/Reason"
        },
        "policy_version": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Policy Version",
          "type": "string"
        },
        "obligations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Obligations",
          "type": "array"
        }
      },
      "required": [
        "allow",
        "reason_code",
        "policy_version"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Reason": {
      "enum": [
        "ALLOW",
        "IDENTITY_DENIED",
        "CLIENT_DENIED",
        "SCOPE_DENIED",
        "RESOURCE_DENIED",
        "RECIPIENT_DENIED",
        "POLICY_STALE",
        "OUTPUT_LIMIT"
      ],
      "title": "Reason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "producer": {
      "const": "knowledge",
      "title": "Producer",
      "type": "string"
    },
    "subject": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "title": "Subject",
      "type": "string"
    },
    "client_id": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "title": "Client Id",
      "type": "string"
    },
    "resource_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Resource Id"
    },
    "operation": {
      "const": "read_document",
      "title": "Operation",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "outcome": {
      "enum": [
        "returned",
        "denied"
      ],
      "title": "Outcome",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "correlation_id",
    "task_id",
    "occurred_at",
    "producer",
    "subject",
    "client_id",
    "resource_id",
    "operation",
    "decision",
    "outcome"
  ],
  "title": "AuditEvent",
  "type": "object"
}
