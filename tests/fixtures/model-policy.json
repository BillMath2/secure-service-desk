{
  "nftables": [
    {
      "metainfo": {
        "version": "1.0.9",
        "release_name": "Old Doc Yak #3",
        "json_schema_version": 1
      }
    },
    {
      "table": {
        "family": "inet",
        "name": "service_desk_model",
        "handle": 3
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "service_desk_model",
        "name": "output",
        "handle": 1,
        "type": "filter",
        "hook": "output",
        "prio": -150,
        "policy": "drop"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "service_desk_model",
        "chain": "output",
        "handle": 2,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": {
                "ct": {
                  "key": "direction"
                }
              },
              "right": "reply"
            }
          },
          {
            "match": {
              "op": "in",
              "left": {
                "ct": {
                  "key": "state"
                }
              },
              "right": "established"
            }
          },
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "tcp",
                  "field": "sport"
                }
              },
              "right": 11434
            }
          },
          {
            "accept": null
          }
        ]
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "service_desk_model",
        "chain": "output",
        "handle": 3,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": {
                "payload": {
                  "protocol": "ip",
                  "field": "daddr"
                }
              },
              "right": "127.0.0.1"
            }
          },
          {
            "match": {
              "op": "==",
              "left": {
                "meta": {
                  "key": "oifname"
                }
              },
              "right": "lo"
            }
          },
          {
            "match": {
              "op": "==",
              "left": {
                "meta": {
                  "key": "l4proto"
                }
              },
              "right": 6
            }
          },
          {
            "accept": null
          }
        ]
      }
    }
  ]
}
